rules_version = '2';

// Storage rules for RUTA.
// Storage rules cannot read the Realtime Database, so admins are listed by UID here.
// Replace ADMIN_UID_1 (and add more with ||) with the UID(s) of your admin account(s):
// Firebase Console -> Authentication -> Users -> copy the "User UID".
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && request.auth.uid in ['ADMIN_UID_1']; }
    function smallImage() {
      return request.resource.size < 5 * 1024 * 1024
          && request.resource.contentType.matches('image/.*');
    }

    // Profile photos (passenger avatar, driver 1x1): any signed-in user may view,
    // only the owner may change. (The driver "locked photo" rule is enforced in the app.)
    match /profiles/{uid}/{file} {
      allow read: if signedIn();
      allow write: if isOwner(uid) && smallImage();
    }

    // Sensitive files: only the owner and an admin can open them.
    match /ids/{uid}/{file} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid) && smallImage();
    }
    match /driver_docs/{uid}/{file} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid) && smallImage();
    }
    match /receipts/{uid}/{file} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid) && smallImage();
    }

    // Older paths kept working.
    match /profile_pictures/{fileName} {
      allow read, write: if signedIn() && fileName == request.auth.uid + '.jpg';
    }
    match /driver_profiles/{fileName} {
      allow read, write: if signedIn() && fileName == request.auth.uid + '.jpg';
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
