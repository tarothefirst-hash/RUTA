rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Passenger profile picture upload: ProfileFragment.kt:251 writes
    // storage.child("profile_pictures/${uid}.jpg") while authenticated as $uid.
    match /profile_pictures/{fileName} {
      allow read, write: if request.auth != null && fileName == request.auth.uid + '.jpg';
    }

    // Driver profile picture upload: DriverProfileFragment.kt:230 writes
    // storage.child("driver_profiles/${uid}.jpg") while authenticated as $uid.
    match /driver_profiles/{fileName} {
      allow read, write: if request.auth != null && fileName == request.auth.uid + '.jpg';
    }

    // Everything else stays locked (default deny).
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
