<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ruta_bg"
    android:fitsSystemWindows="true">

    <!-- Fragment Container -->
    <FrameLayout
        android:id="@+id/driverFragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/driverBottomNav" />

    <!-- Bottom Navigation Bar -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/driverBottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/ruta_card_bg"
        app:elevation="8dp"
        app:itemIconTint="@color/ruta_primary"
        app:itemTextColor="@color/ruta_primary"
        app:menu="@menu/menu_driver_bottom_nav" />

</RelativeLayout>