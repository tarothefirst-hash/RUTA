<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ruta_bg">

    <!-- Map View -->
    <fragment
        android:id="@+id/driverMap"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Bar: Online Status & Verification State -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardBackgroundColor="@color/ruta_card_bg"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <TextView
                android:id="@+id/txtDriverStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/dr_status_offline"
                android:textColor="@color/ruta_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchOnline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Target Selector Bar (Floating Controls) -->
    <LinearLayout
        android:id="@+id/layoutTargetSelector"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Recenter Location Button -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnMyLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Recenter Map"
            app:backgroundTint="@color/ruta_card_bg"
            app:fabCustomSize="44dp"
            app:srcCompat="@android:drawable/ic_menu_mylocation"
            app:tint="@color/ruta_primary" />

        <!-- Target Selector Pill Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            app:cardBackgroundColor="@color/ruta_card_bg"
            app:cardCornerRadius="22dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <ImageButton
                    android:id="@+id/btnPrevContact"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Previous Pin"
                    android:src="@android:drawable/ic_media_previous"
                    app:tint="@color/ruta_primary" />

                <TextView
                    android:id="@+id/txtCurrentTargetIndicator"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Pin: Me"
                    android:textColor="@color/ruta_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnNextContact"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Next Pin"
                    android:src="@android:drawable/ic_media_next"
                    app:tint="@color/ruta_primary" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- Compact Chat Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnChatWithPassenger"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_above="@id/cardIncomingRequest"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="4dp"
        android:backgroundTint="@color/ruta_primary"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:padding="0dp"
        android:text="@string/dr_chat_with_passenger"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:cornerRadius="10dp" />

    <!-- Incoming Ride Request / Active Trip Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardIncomingRequest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/ruta_card_bg"
        app:cardCornerRadius="16dp"
        app:cardElevation="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Card Header: Title & Minimize Toggle Button -->
            <RelativeLayout
                android:id="@+id/layoutCardHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/imgPassengerAvatar"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/txtPassengerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/imgPassengerAvatar"
                    android:layout_toStartOf="@id/btnMinimizeCard"
                    android:text="@string/h_passenger_name_hint"
                    android:textColor="@color/ruta_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnMinimizeCard"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Minimize Card"
                    android:src="@android:drawable/arrow_down_float"
                    app:tint="@color/ruta_text_secondary" />

            </RelativeLayout>

            <!-- Collapsible Body Container -->
            <LinearLayout
                android:id="@+id/layoutCardContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp"
                android:visibility="visible">

                <TextView
                    android:id="@+id/txtPickupLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/dr_pickup_location_default"
                    android:textColor="@color/ruta_text_secondary" />

                <TextView
                    android:id="@+id/txtDropoffLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/dr_dropoff_location_default"
                    android:textColor="@color/ruta_text_secondary" />

                <TextView
                    android:id="@+id/txtEstimatedFare"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/dr_estimated_fare_default"
                    android:textColor="@color/ruta_status_success"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtWalletBalance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingEnd="8dp"
                    android:text="@string/dr_wallet_balance_default"
                    android:textColor="@color/ruta_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Action Buttons Container -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnDeclineRide"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:text="@string/dr_decline"
                        android:textColor="@color/ruta_cancel" />

                    <Button
                        android:id="@+id/btnAcceptRide"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:backgroundTint="@color/ruta_status_success"
                        android:text="@string/dr_accept_ride" />

                </LinearLayout>

                <!-- Pickup Waiting Timer -->
                <TextView
                    android:id="@+id/txtPickupTimer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:padding="8dp"
                    android:textColor="@color/ruta_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <!-- Single Full-Width Action Buttons -->
                <Button
                    android:id="@+id/btnConfirmPickup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:backgroundTint="@color/ruta_primary"
                    android:text="@string/dr_confirm_passenger_pickup"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnReportNoShow"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Report No-Show"
                    android:textColor="@color/ruta_cancel"
                    android:visibility="gone"
                    app:strokeColor="@color/ruta_cancel" />

                <Button
                    android:id="@+id/btnCompleteRide"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="@color/ruta_status_success"
                    android:text="@string/dr_complete_ride"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- ===== Driver navigation overlay: turn banner, deviation status, alert popup ===== -->
    <LinearLayout
        android:id="@+id/layoutOverlayTop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/cardTopBar"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:orientation="vertical">

        <!-- Next turn -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardNavBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardBackgroundColor="@color/ruta_primary"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <TextView
                    android:id="@+id/txtNavArrow"
                    android:layout_width="56dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="↑"
                    android:textColor="#FFFFFF"
                    android:textSize="40sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtNavDistance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtNavInstruction"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:text=""
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtNavSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:gravity="center"
                    android:text="0\nkm/h"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Route deviation status (waiting for approval / reroute denied) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardDeviationStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            app:cardBackgroundColor="#FFF4E5"
            app:cardCornerRadius="14dp"
            app:cardElevation="8dp">

            <TextView
                android:id="@+id/txtDeviationStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text=""
                android:textColor="#7A4B00"
                android:textSize="13sp"
                android:textStyle="bold" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Incoming trusted-contact deviation / emergency warning (never takes over the map) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAlertBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            app:cardBackgroundColor="#FDECEA"
            app:cardCornerRadius="14dp"
            app:cardElevation="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/txtAlertTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Emergency alert"
                    android:textColor="#B71C1C"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtAlertBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text=""
                    android:textColor="#5F2120"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAlertTrack"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:backgroundTint="#C62828"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Track on map"
                        android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAlertDismiss"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Dismiss"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Voice mute + "back to my screen" -->
    <LinearLayout
        android:id="@+id/layoutNavControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_below="@id/layoutOverlayTop"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:gravity="end"
        android:orientation="vertical">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnDriverSos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:contentDescription="Emergency SOS"
            android:visibility="gone"
            app:backgroundTint="#C62828"
            app:fabCustomSize="48dp"
            app:srcCompat="@android:drawable/ic_dialog_alert"
            app:tint="#FFFFFF" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnMuteVoice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Mute voice guidance"
            app:backgroundTint="@color/ruta_card_bg"
            app:fabCustomSize="44dp"
            app:srcCompat="@android:drawable/ic_lock_silent_mode_off"
            app:tint="@color/ruta_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackToMyScreen"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/ruta_primary"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Back to my screen"
            android:textSize="12sp"
            android:visibility="gone"
            app:cornerRadius="20dp" />
    </LinearLayout>

</RelativeLayout>
