<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/a_profile_user_profile"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="20dp" />

        <!-- First Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/d_first_name_hint"
            android:textSize="14sp"
            android:textColor="#666666" />

        <EditText
            android:id="@+id/edtProfileFirstName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/d_first_name_hint"
            android:inputType="textPersonName"
            android:layout_marginBottom="16dp" />

        <!-- Last Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/d_last_name_hint"
            android:textSize="14sp"
            android:textColor="#666666" />

        <EditText
            android:id="@+id/edtProfileLastName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/d_last_name_hint"
            android:inputType="textPersonName"
            android:layout_marginBottom="16dp" />

        <!-- Phone Number -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/d_phone_number_hint"
            android:textSize="14sp"
            android:textColor="#666666" />

        <EditText
            android:id="@+id/edtProfilePhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/a_profile_phone_hint"
            android:inputType="phone"
            android:layout_marginBottom="24dp" />

        <!-- Save Changes Button -->
        <Button
            android:id="@+id/btnSaveProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/h_save_changes"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp" />

        <!-- Logout Button -->
        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/h_settings_log_out"
            android:backgroundTint="#E53935"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>