<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Shown once the admin approves the discount ID: replaces the whole form -->
    <LinearLayout
        android:id="@+id/layoutDiscountApproved"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:elevation="4dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:background="@drawable/bg_badge_green"
            android:gravity="center"
            android:text="✓"
            android:textColor="@color/white"
            android:textSize="52sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Registration Complete"
            android:textColor="@color/ruta_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="Enjoy your 20% Discount on Solo Ride"
            android:textColor="@color/ruta_text_primary"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Your ID was verified. The discount is applied automatically to your solo rides."
            android:textColor="@color/ruta_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollDiscountForm"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:paddingBottom="40dp"
        android:clipToPadding="false">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/h_promos_title"
            android:textColor="@color/ruta_red"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:text="@string/h_promos_subtitle"
            android:textColor="@color/ruta_primary_dark"
            android:textSize="13sp" />

        <!-- Verification Status Indicator -->
        <TextView
            android:id="@+id/txtVerificationStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="#FFF8E1"
            android:padding="12dp"
            android:text="Status: Not Submitted"
            android:textColor="#F57F17"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Discount Type Selection -->
        <RadioGroup
            android:id="@+id/radioGroupDiscount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radioStudent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:text="@string/h_discount_student"
                android:textColor="@color/ruta_black"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/radioSenior"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/h_discount_senior_pwd"
                android:textColor="@color/ruta_black"
                android:textSize="14sp" />
        </RadioGroup>

        <!-- 5MB FILE SIZE LIMIT NOTICE -->
        <TextView
            android:id="@+id/txtLimitNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp"
            android:text="Note: Upload clear ID photos up to 5MB max per file."
            android:textColor="@color/ruta_primary_dark"
            android:textSize="12sp"
            android:textStyle="italic" />

        <!-- ID Document Upload Section -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_outline"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/h_upload_id_title"
                    android:textColor="@color/ruta_red"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp"
                    android:text="@string/h_upload_id_instructions"
                    android:textColor="@color/ruta_primary_dark"
                    android:textSize="12sp" />

                <!-- Front ID Preview & Button -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/h_id_front_label"
                    android:textColor="@color/ruta_black"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/imgFrontPreview"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:layout_marginTop="8dp"
                    android:background="#F3F4F6"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_business" />

                <Button
                    android:id="@+id/btnUploadFront"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:backgroundTint="@color/ruta_red"
                    android:text="@string/h_upload_id_front_button"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textAllCaps="false" />

                <!-- Back ID Preview & Button -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/h_id_back_label"
                    android:textColor="@color/ruta_black"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/imgBackPreview"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:layout_marginTop="8dp"
                    android:background="#F3F4F6"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_business" />

                <Button
                    android:id="@+id/btnUploadBack"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_marginTop="8dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:backgroundTint="@color/ruta_red"
                    android:text="@string/h_upload_id_back_button"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textAllCaps="false" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Loading Progress Bar -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="12dp"
            android:visibility="gone" />

        <!-- Submit Button -->
        <Button
            android:id="@+id/btnSubmitDiscount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:backgroundTint="@color/ruta_red"
            android:text="@string/h_submit_verification"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textAllCaps="false" />

    </LinearLayout>
</ScrollView>
</FrameLayout>
