<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ruta_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        android:paddingTop="56dp"
        android:paddingBottom="100dp"
        android:clipToPadding="false">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ruta_logo"
            android:contentDescription="@string/app_name"
            android:layout_gravity="center_horizontal" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:text="@string/signup_title"
            android:textColor="@color/ruta_text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:text="@string/signup_subtitle"
            android:textColor="@color/ruta_text_secondary"
            android:textSize="14sp" />

        <!-- Role picker -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/signup_as"
            android:textColor="@color/ruta_text_secondary"
            android:textSize="13sp" />

        <RadioGroup
            android:id="@+id/roleGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <RadioButton
                android:id="@+id/roleUser"
                style="@style/Widget.AppCompat.CompoundButton.RadioButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:button="@null"
                android:gravity="center"
                android:checked="true"
                android:background="@drawable/bg_role_chip"
                android:textColor="@color/role_chip_text"
                android:text="@string/role_passenger"
                android:textSize="12sp" />

            <RadioButton
                android:id="@+id/roleDriver"
                style="@style/Widget.AppCompat.CompoundButton.RadioButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:button="@null"
                android:gravity="center"
                android:background="@drawable/bg_role_chip"
                android:textColor="@color/role_chip_text"
                android:text="@string/role_driver"
                android:textSize="12sp" />

        </RadioGroup>

        <!-- First Name & Last Name -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/edtFirstName"
                style="@style/RutaEditText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:hint="First Name"
                android:inputType="textPersonName"
                android:autofillHints="personGivenName" />

            <EditText
                android:id="@+id/edtLastName"
                style="@style/RutaEditText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:hint="Last Name"
                android:inputType="textPersonName"
                android:autofillHints="personFamilyName" />

        </LinearLayout>

        <EditText
            android:id="@+id/edtEmail"
            style="@style/RutaEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="@string/email_hint"
            android:inputType="textEmailAddress"
            android:autofillHints="emailAddress" />

        <!-- Birth Date Field -->
        <EditText
            android:id="@+id/edtBirthDate"
            style="@style/RutaEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="Birth Date (YYYY-MM-DD)"
            android:inputType="date" />

        <EditText
            android:id="@+id/edtPassword"
            style="@style/RutaEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="@string/password_hint"
            android:inputType="textPassword"
            android:autofillHints="newPassword" />

        <EditText
            android:id="@+id/edtConfirmPassword"
            style="@style/RutaEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="@string/confirm_password_hint"
            android:inputType="textPassword"
            android:autofillHints="newPassword" />

        <LinearLayout
            android:id="@+id/layoutDriverFields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Vehicle Information"
                android:textColor="@color/ruta_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtVehicleModel"
                style="@style/RutaEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Vehicle Model (e.g., Toyota Vios)"
                android:inputType="textCapWords" />

            <!-- Row for Plate Number & Vehicle Color -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp">

                    <EditText
                        android:id="@+id/edtPlateNumber"
                        style="@style/RutaEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Plate Number"
                        android:inputType="textCapCharacters" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp">

                    <EditText
                        android:id="@+id/edtVehicleColor"
                        style="@style/RutaEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Color (e.g., Black)"
                        android:inputType="textCapWords" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/txtError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/ruta_cancel"
            android:textSize="12sp"
            android:visibility="gone"
            tools:visibility="visible"
            tools:text="Error message" />

        <Button
            android:id="@+id/btnSignup"
            style="@style/RutaButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="22dp"
            android:backgroundTint="@color/ruta_primary"
            android:text="@string/signup_button"
            android:textAllCaps="false" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/ruta_text_muted" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:text="OR"
                android:textColor="@color/ruta_text_muted"
                android:textSize="12sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/ruta_text_muted" />

        </LinearLayout>

        <!-- Full Width Google Button -->
        <Button
            android:id="@+id/btnGoogle"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:text="Sign up with Google"
            android:textColor="@color/ruta_primary"
            android:textAllCaps="false"
            app:strokeColor="@color/ruta_primary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/have_account"
                android:textColor="@color/ruta_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txtGoLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/login_link"
                android:textColor="@color/ruta_primary"
                android:textStyle="bold"
                android:textSize="13sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>