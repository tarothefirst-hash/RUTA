<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.RUTA" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/ruta_primary</item>
        <item name="colorPrimaryVariant">@color/ruta_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/ruta_primary</item>
        <item name="colorSecondaryVariant">@color/ruta_primary_dark</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/ruta_primary</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>

    <style name="Theme.RUTA.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Custom View Styles -->
    <style name="RutaEditText">
        <item name="android:padding">14dp</item>
        <item name="android:textColor">@color/ruta_text_primary</item>
        <item name="android:textColorHint">@color/ruta_text_muted</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="RutaButton" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:padding">14dp</item>
        <item name="backgroundTint">@color/ruta_primary</item>
        <item name="cornerRadius">12dp</item>
    </style>

</resources>