<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.RUTA" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/ruta_red</item>
        <item name="colorPrimaryDark">@color/ruta_red_dark</item>
        <item name="colorAccent">@color/ruta_red</item>
        <item name="android:statusBarColor">@color/ruta_red</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>

    <style name="Theme.RUTA.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="RutaEditText">
        <item name="android:background">@drawable/bg_input_field</item>
        <item name="android:padding">14dp</item>
        <item name="android:textColor">@color/text_dark</item>
        <item name="android:textColorHint">@color/text_gray</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="RutaButton">
        <item name="android:background">@drawable/bg_button_red</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:padding">14dp</item>
    </style>
</resources>
